#!/usr/bin/env python3

import time
import sys

target = sys.argv[1] if len(sys.argv) > 1 else "example.com"
duration = sys.argv[3] if len(sys.argv) > 3 else "10"
limit = sys.argv[4] if len(sys.argv) > 4 else "100"

frames = [
    "⠋ Loading...",
    "⠙ Loading...",
    "⠹ Loading...",
    "⠸ Loading...",
    "⠼ Loading...",
    "⠴ Loading...",
    "⠦ Loading...",
    "⠧ Loading...",
    "⠇ Loading...",
    "⠏ Loading..."
]

try:
    print(f"Target: {target}")
    print(f"Time: {duration}")
    print(f"Limit: {limit}")

    for _ in range(3):
        for frame in frames:
            sys.stdout.write("\r\033[96m" + frame + "\033[0m")
            sys.stdout.flush()
            time.sleep(0.1)

    sys.stdout.write("\r\033[92m✓ Animation completed!\033[0m\n")
    sys.stdout.flush()

except KeyboardInterrupt:
    print("\nAnimation stopped.")
